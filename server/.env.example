# Server Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or Local)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example: mongodb+srv://admin:MyPassword123@cluster0.abcde.mongodb.net/medicare_hms?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medicare_hms

# JWT Authentication
JWT_SECRET=medicare-super-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=medicare-super-secret-refresh-key-2026
JWT_REFRESH_EXPIRES_IN=30d

# CORS & Client URL (Update to your deployed frontend domain)
CLIENT_URL=http://localhost:5173
TAX_PERCENTAGE=5.0
